# ====================================================================
# m-monitor 环境变量模板
# 用法：cp .env.example .env，然后填入真实值；docker compose 会自动加载
# ====================================================================

# ─── BochaAI 搜索（新闻采集） ───
BOCHA_API_KEY=
BOCHA_BASE_URL=https://api.bocha.cn/v1/ai-search

# ─── DashScope 通义千问（LLM + Vision） ───
DASHSCOPE_API_KEY=
DASHSCOPE_REPORT_MODEL=qwen-max
DASHSCOPE_SCREENING_MODEL=qwen-turbo
DASHSCOPE_VISION_MODEL=qwen-vl-max-latest

# ─── 飞书机器人 Webhook（legacy：普通日报/历史调用可用，竞品日报已改为应用机器人）───
FEISHU_TEST_WEBHOOK_URL=
FEISHU_PROD_WEBHOOK_URL=
FEISHU_COMPETITOR_WEBHOOK_URL=

# ─── 飞书应用机器人（竞品日报推送）───
# 需要把应用机器人加入目标群，并填群 open_chat_id（oc_xxx）。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_COMPETITOR_CHAT_ID=
FEISHU_CARD_LONG_CONNECTION_ENABLED=true

# ─── 飞书卡片反馈（卡片内文字按钮 → 后端回调 → 飞书 CLI 写多维表格）───
# 回调 token 来自飞书开放平台卡片回调配置；为空时本地调试不校验。
FEISHU_CARD_VERIFICATION_TOKEN=
# Windows 可写完整路径；npm 版 CLI 在 Windows 下建议使用 lark-cli.cmd。
FEISHU_CLI_PATH=lark-cli.cmd
# lark-cli 写表身份：user 表示使用你授权的账号；bot 表示应用机器人身份。
FEISHU_CLI_AS=user
# 多维表格 URL 中 /base/ 后的 token；lark-cli 参数名为 --base-token。
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=

# ─── 飞书应用 OAuth（H5 强制登录用；复用上面的 FEISHU_APP_ID/SECRET）───
# 拿凭证：https://open.feishu.cn/app → 创建企业自建应用
# 配 redirect URI：应用安全设置 → 重定向 URL 白名单加 FEISHU_OAUTH_REDIRECT 的值
FEISHU_OAUTH_REDIRECT=http://localhost:3080/h5/benchmark
FEISHU_REQUIRE_LOGIN=true

# ─── 社交平台 cookie（爬虫用，空 → 走二维码登录）───
XHS_COOKIE_STR=
DOUYIN_COOKIE_STR=
WEIBO_COOKIE_STR=
BILI_COOKIE_STR=
KS_COOKIE_STR=

# ─── RAGFlow 知识库 ───
RAGFLOW_API_KEY=
RAGFLOW_KB_ID=
RAGFLOW_BASE_URL=http://host.docker.internal:9380
RAGFLOW_UI_BASE_URL=http://localhost

# ─── RAGFlow 智能深度对标 Agent ───
# 在 RAGFlow UI 创建 Agent canvas 后，「嵌入网页」拿到 iframe URL 中的 shared_id + auth 填这里
RAGFLOW_DEEP_ANALYSIS_SHARED_ID=
RAGFLOW_DEEP_ANALYSIS_BETA_TOKEN=
RAGFLOW_DEEP_ANALYSIS_FROM=agent

# ─── RAGFlow Chat Assistant（已废弃，留兼容）───
NEVINSIGHT_RAGFLOW_DEEP_BENCHMARK_AGENT_ID=
NEVINSIGHT_RAGFLOW_DEEP_BENCHMARK_CHAT_ID=
NEVINSIGHT_RAGFLOW_FOLLOWUP_CHAT_ID=

# ─── 数据库 / 中间件 ───
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nev_insight
DB_USER=root
DB_PASSWORD=nev123456
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_SERVERS=localhost:9092
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ─── 爬虫服务地址 ───
CRAWLER_BASE_URL=http://host.docker.internal:8091
CRAWLER_DISABLED_PLATFORMS=xhs

# ─── 前端 base URL（飞书卡片按钮拼链接用）───
FRONTEND_BASE_URL=http://localhost:3080

# ─── 定时任务 cron ───
COMPETITOR_REPORT_CRON=0 30 8 * * ?
AUTOHOME_SYNC_CRON=0 0 3 ? * MON
NEVINSIGHT_CRAWLER_NEWS_CRON_SELF_COMPETITOR=0 0 6,12,18,23 * * ?
NEVINSIGHT_CRAWLER_NEWS_CRON_INDUSTRY=0 30 6 * * ?

# ─── 品牌名（多品牌部署时改这里）───
BRAND_NAME=猛士汽车
BRAND_DB_NAME=猛士
